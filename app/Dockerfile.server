FROM condaforge/mambaforge:24.9.2-0

SHELL ["/bin/bash", "-lc"]

ARG USERNAME=app
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME \
 && useradd  --uid $USER_UID --gid $USER_GID -m $USERNAME

WORKDIR /app

COPY server-environment.yml /app/
COPY server-requirements.txt /app/

# Create conda env
RUN mamba env create -n web -f server-environment.yml \
 && conda clean -afy

# Allow non-root user to write antiSMASH runtime-generated assets
RUN chown -R ${USER_UID}:${USER_GID} /opt/conda/envs/web/lib/python3.9/site-packages/antismash

RUN echo "conda activate web" >> /etc/bash.bashrc

# Make antiSMASH's module data dirs writable by the runtime user. Some RiPP
# modules (lanthipeptides, lassopeptides, etc.) lazily write trained-classifier
# .pkl files into their own site-packages data/ dirs on first run, which fails
# under a non-root runtime user unless we hand over ownership here.
RUN AS_ROOT="/opt/conda/envs/web/lib/python3.9/site-packages/antismash" \
 && chown -R ${USER_UID}:${USER_GID} "$AS_ROOT/modules" \
 && find "$AS_ROOT/modules" -type d -name data -exec chmod -R u+rwX,g+rwX {} +

# Copy startup script
COPY --chown=root:root src/server/start.sh /app/start.sh
RUN chmod +x /app/start.sh \
 && sed -i 's/\r$//' /app/start.sh

# App code
COPY --chown=${USER_UID}:${USER_GID} ./src/server/ /app/

RUN mkdir -p /app/temp /app/antismash_databases \
 && chown -R ${USER_UID}:${USER_GID} /app

ENV PYTHONUNBUFFERED=1 \
    LOG_LEVEL=INFO \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    JOBLIB_MMAP_MODE=r

EXPOSE 4009

# start.sh runs as root, checks DB, downloads only if missing, then drops to `app` for gunicorn
ENTRYPOINT ["/app/start.sh"]